# ==============================================================================
# SPAM EMAIL DETECTION CONSOLE - UNIFIED ENVIRONMENT CONFIGURATIONS
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND SETTINGS (fastapi)
# ------------------------------------------------------------------------------
# In Docker compose, point to database host: "mongodb://database:27017/phishing_detection_db"
# In local Python environment, point to local database host: "mongodb://localhost:27017/phishing_detection_db"
# In production, point to MongoDB Atlas cluster URI
MONGODB_URI=mongodb://database:27017/phishing_detection_db
MONGODB_DATABASE=phishing_detection_db

# Security & JWT Tokens
# Minimum 256-bit cryptographically secure random string
JWT_SECRET_KEY=generate-a-secure-256-bit-key-for-jwt-signatures
JWT_REFRESH_SECRET_KEY=generate-a-secure-256-bit-key-for-refresh-signatures
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Decision Threshold (minimum probability to flag as suspicious)
DECISION_THRESHOLD=0.65

# Classifier Versioning
ACTIVE_MODEL_VERSION=v1.0.0

# Server Core settings
# In Compose, set to "http://localhost:3000" to match frontend host loopback port
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Backend Sentry DSN
SENTRY_DSN=

# Google OAuth2 (Gmail API)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/inbox/gmail/callback
INBOX_SCAN_LIMIT_MAX=200


# ------------------------------------------------------------------------------
# FRONTEND SETTINGS (vite)
# ------------------------------------------------------------------------------
# Base API URL used by the Axios client.
# In local/docker development, point to the backend proxy port: "http://localhost:8000"
# In production, point to the deployed backend URL
VITE_API_URL=http://localhost:8000

# Frontend Sentry DSN
VITE_SENTRY_DSN=
