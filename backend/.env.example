# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/phishing_detection_db
MONGODB_DATABASE=phishing_detection_db

# JWT Authentication (for Phase 2+)
JWT_SECRET_KEY=your-secret-key-here-minimum-256-bits-long-random-string
JWT_REFRESH_SECRET_KEY=your-refresh-secret-key-here-minimum-256-bits-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ML Configuration
DECISION_THRESHOLD=0.65
ACTIVE_MODEL_VERSION=v1.0.0

# Monitoring
SENTRY_DSN=

# Server Configurations
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
